{
  "id": "root",
  "preview": "layouts/fedra.svg",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "my-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "my-spaces"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "usage",
          "type": "block",
          "content": {
            "mod": "usage-card"
          },
          "size": {
            "px": 106
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "my-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 233
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-split",
          "type": "column",
          "children": [
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "my-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "size": {
                    "px": 535
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": false,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "my-files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        },
                        {
                          "id": "browser",
                          "type": "block",
                          "content": {
                            "mod": "browser-panel"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ]
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "quick-terminal",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 260
              },
              "min": 120,
              "max": 700,
              "padding": [
                0,
                8
              ],
              "children": [
                {
                  "id": "quick-terminal-card",
                  "type": "column",
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "background": "background",
                  "children": [
                    {
                      "id": "quick-terminal-header",
                      "type": "block",
                      "content": {
                        "mod": "my-status",
                        "props": {
                          "part": "terminal-header"
                        }
                      },
                      "size": {
                        "px": 30
                      }
                    },
                    {
                      "id": "quick-terminal-term",
                      "type": "block",
                      "content": {
                        "mod": "my-status",
                        "props": {
                          "part": "terminal-empty"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "my-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "paper",
    "dark": "moss"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
