#!/bin/bash
# Builds this checkout (the app and its core: scripts/build), points
# ~/.local/bin/atrous (and atc) at the release build, which holds the core
# beside the app, and adds the launcher entry with the Atrous icon. Re-run
# after moving the checkout.
set -euo pipefail

[[ $(uname -s) == Linux ]] || { echo 'This installer is for Linux.' >&2; exit 1; }
cd "$(dirname "$0")/.."
scripts/build

data=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$HOME/.local/bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
ln -sfn "$PWD/target/release/atrous" "$HOME/.local/bin/atrous"
# atc for shells outside Atrous; a file someone put there is left alone.
if [[ ! -e $HOME/.local/bin/atc || -L $HOME/.local/bin/atc ]]; then
  ln -sfn "$PWD/target/release/atrous-core" "$HOME/.local/bin/atc"
fi
cp assets/brand/atrous.svg "$data/icons/hicolor/scalable/apps/atrous.svg"
cat > "$data/applications/atrous.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Atrous
Comment=Terminals and coding agents that keep running
Exec=$HOME/.local/bin/atrous
Icon=atrous
Terminal=false
Categories=Development;
StartupWMClass=atrous
EOF
update-desktop-database "$data/applications" 2>/dev/null || true
# A stale icon cache hides new icons until it's rebuilt.
[[ -f $data/icons/hicolor/icon-theme.cache ]] && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
echo "Installed atrous. Quit and reopen Atrous to use the new build."
