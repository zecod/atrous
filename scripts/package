#!/bin/bash
# Builds a release of the app for this machine and packs it:
#
#   scripts/package            -> dist/atrous-<os>-<arch>.tar.gz
#   scripts/package <triple>   -> the same for another supported Rust target
#
# One release holds the app and its core (core/, built here too), at the
# same version; they install and update together:
# Linux: a folder holding atrous, atrous-core, atc (-> atrous-core) and the icon.
# macOS: Atrous.app with the core as a helper bundle,
#   Contents/Helpers/Atrous Core.app (its own identity, for launchd and
#   signing; Contents/MacOS/atc -> atrous-core), signed with
#   APPLE_CERTIFICATE_P12 when available, otherwise ad hoc. The notarized
#   DMG is a separate, non-blocking CI job.
# Windows (Git Bash): a folder holding atrous.exe, atrous-core.exe, atc.exe
# (a hard link to it), conpty\ and the icon.
# Windows has curl and tar too, so the app updates the same way.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
  corebin=core/target/$triple/release
else
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $(uname -s)" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
  corebin=core/target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
if [[ $os == macos && $arch != aarch64 ]]; then
  echo "package: Intel Macs aren't supported; build from source instead." >&2
  exit 1
fi
target="$os-$arch"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: atrous $version for $target"
for notice in LICENSE THIRD-PARTY-NOTICES core/crates/atrous-core/THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done
# Only release builds update themselves (src/update.rs).
ATROUS_RELEASE=1 cargo build --release --locked ${triple:+--target "$triple"}
cargo build --release --locked --manifest-path core/Cargo.toml ${triple:+--target "$triple"}
core_version=$("$corebin/atrous-core$([[ $os == windows ]] && echo .exe)" --version)
[[ $core_version == "atc $version" ]] || { echo "package: the core says '$core_version', the app is $version: one version for both" >&2; exit 1; }

if [[ $os == linux ]]; then export TMPDIR=${TMPDIR:-/var/tmp}; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
out="dist/atrous-$target.tar.gz"
if [[ $os == linux || $os == windows ]]; then
  dir="$work/atrous"
  mkdir -p "$dir"
  if [[ $os == windows ]]; then cp "$bin/atrous.exe" "$dir/"; else cp "$bin/atrous" "$dir/"; fi
  scripts/stage-core "$dir" "$corebin"
  cp assets/brand/atrous.svg "$dir/atrous.svg"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  cp core/crates/atrous-core/THIRD-PARTY-NOTICES "$dir/THIRD-PARTY-NOTICES-atrous-core"
  notices_path=atrous/THIRD-PARTY-NOTICES
  tar -czf "$out" -C "$work" atrous
else
  app="$work/Atrous.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/atrous" "$app/Contents/MacOS/Atrous"
  cp assets/brand/Atrous.icns "$app/Contents/Resources/Atrous.icns"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  cp core/crates/atrous-core/THIRD-PARTY-NOTICES "$app/Contents/Resources/THIRD-PARTY-NOTICES-atrous-core"
  notices_path=Atrous.app/Contents/Resources/THIRD-PARTY-NOTICES
  # The core: its own bundle (identity io.github.zecod.atrous.core, which it
  # checks), signed first; the app's signature then seals it in.
  helper="$app/Contents/Helpers/Atrous Core.app"
  mkdir -p "$app/Contents/Helpers"
  sh core/scripts/mac-bundle "$corebin/atrous-core" "$helper"
  ln -s atrous-core "$helper/Contents/MacOS/atc"
  bash core/scripts/mac-sign "$helper"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Atrous</string>
    <key>CFBundleIdentifier</key><string>io.github.zecod.atrous</string>
    <key>CFBundleName</key><string>Atrous</string>
    <key>CFBundleDisplayName</key><string>Atrous</string>
    <key>CFBundleIconFile</key><string>Atrous</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Atrous can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Atrous can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Atrous can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
  scripts/mac-sign "$app"
  tar -czf "$out" -C "$work" Atrous.app
fi
tar -xOf "$out" "$notices_path" | cmp - THIRD-PARTY-NOTICES
license_path="${notices_path%/*}/LICENSE"
tar -xOf "$out" "$license_path" | cmp - LICENSE
echo "package: $out ($(sha256 "$out"))"
