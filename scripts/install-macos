#!/bin/bash
# Builds this checkout (the app and its core: scripts/build) and installs
# ~/Applications/Atrous.app with the core inside as a helper bundle,
# Contents/Helpers/Atrous Core.app, plus ~/.local/bin/atrous and atc links
# into it. A running core keeps running; Atrous's next start restarts it
# into this one, terminals kept.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
scripts/build

app="$HOME/Applications/Atrous.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running Atrous.
cp target/release/atrous "$app/Contents/MacOS/Atrous.new"
mv -f "$app/Contents/MacOS/Atrous.new" "$app/Contents/MacOS/Atrous"
chmod +x "$app/Contents/MacOS/Atrous"
cp assets/brand/Atrous.icns "$app/Contents/Resources/Atrous.icns"

cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Atrous</string>
    <key>CFBundleIdentifier</key><string>io.github.zecod.atrous</string>
    <key>CFBundleName</key><string>Atrous</string>
    <key>CFBundleDisplayName</key><string>Atrous</string>
    <key>CFBundleIconFile</key><string>Atrous</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Atrous can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Atrous can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Atrous can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; atc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
# The core: built fresh beside, then swapped in whole (a running core keeps
# its old files), signed before the app seals it.
helper="$app/Contents/Helpers/Atrous Core.app"
mkdir -p "$app/Contents/Helpers"
rm -rf "$helper.new"
sh core/scripts/mac-bundle core/target/release/atrous-core "$helper.new"
ln -s atrous-core "$helper.new/Contents/MacOS/atc"
bash core/scripts/mac-sign "$helper.new"
rm -rf "$helper.old"
[[ -e $helper ]] && mv "$helper" "$helper.old"
mv "$helper.new" "$helper"
rm -rf "$helper.old" 2>/dev/null || true
codesign --force --sign - "$app"
ln -sfn "$app/Contents/MacOS/Atrous" "$HOME/.local/bin/atrous"
# atc for shells outside Atrous (terminals Atrous starts have it on PATH);
# a file someone put there is left alone.
if [[ ! -e $HOME/.local/bin/atc || -L $HOME/.local/bin/atc ]]; then
  ln -sfn "$helper/Contents/MacOS/atrous-core" "$HOME/.local/bin/atc"
fi
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen Atrous to use the new build."
